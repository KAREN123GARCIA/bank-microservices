<?xml version="1.0" encoding="UTF-8"?>
<definitions name="AccountService"
             targetNamespace="http://example.com/account"
             xmlns:tns="http://example.com/account"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

  <types>
    <xsd:schema targetNamespace="http://example.com/account">
      <xsd:element name="ValidateAccountRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ValidateAccountResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="isActive" type="xsd:boolean"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="ValidateAccountRequest">
    <part name="parameters" element="tns:ValidateAccountRequest"/>
  </message>
  <message name="ValidateAccountResponse">
    <part name="parameters" element="tns:ValidateAccountResponse"/>
  </message>

  <portType name="AccountServicePortType">
    <operation name="ValidateAccount">
      <input message="tns:ValidateAccountRequest"/>
      <output message="tns:ValidateAccountResponse"/>
    </operation>
  </portType>

  <binding name="AccountServiceBinding" type="tns:AccountServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="ValidateAccount">
      <soap:operation soapAction="http://example.com/account/ValidateAccount"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="AccountService">
    <port name="AccountServicePort" binding="tns:AccountServiceBinding">
      <soap:address location="http://localhost:8088/wsdl"/>
    </port>
  </service>
</definitions>
