<?xml version="1.0" encoding="UTF-8"?>
<definitions name="AccountService"
             targetNamespace="http://example.com/account"
             xmlns:tns="http://example.com/account"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

  <types>
    <xsd:schema targetNamespace="http://example.com/account">
      <xsd:element name="CloseAccountRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CloseAccountResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="accountId" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="CloseAccountRequest">
    <part name="parameters" element="tns:CloseAccountRequest"/>
  </message>
  <message name="CloseAccountResponse">
    <part name="parameters" element="tns:CloseAccountResponse"/>
  </message>

  <portType name="AccountServicePortType">
    <operation name="CloseAccount">
      <input message="tns:CloseAccountRequest"/>
      <output message="tns:CloseAccountResponse"/>
    </operation>
  </portType>

  <binding name="AccountServiceBinding" type="tns:AccountServicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CloseAccount">
      <soap:operation soapAction="http://example.com/account/CloseAccount"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="AccountService">
    <port name="AccountServicePort" binding="tns:AccountServiceBinding">
      <soap:address location="http://localhost:8087/wsdl"/>
    </port>
  </service>
</definitions>
